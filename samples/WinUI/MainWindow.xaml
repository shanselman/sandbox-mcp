<Window
    x:Class="HelloWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hello WinUI">
    <Grid x:Name="Root" Padding="24" RowSpacing="16"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <XamlUICommand x:Key="GreetCommand" ExecuteRequested="GreetRequested" />
            <XamlUICommand x:Key="IncrementCommand" ExecuteRequested="IncrementRequested" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Hello, Windows Sandbox"
                   Style="{StaticResource TitleTextBlockStyle}" />
        <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox"
                 Grid.Row="1" Header="Your name" Text="Sandbox" />
        <Button AutomationProperties.AutomationId="GreetButton"
                Grid.Row="2" Content="Greet" Command="{StaticResource GreetCommand}" />
        <TextBlock x:Name="Output" AutomationProperties.AutomationId="Output"
                   Grid.Row="3" Text="Hello, Sandbox!" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16">
            <Button AutomationProperties.AutomationId="IncrementButton"
                    Content="Increment" Command="{StaticResource IncrementCommand}" />
            <TextBlock x:Name="Counter" AutomationProperties.AutomationId="Counter"
                       VerticalAlignment="Center" Text="Count: 0" />
        </StackPanel>
        <TextBlock x:Name="VariantInfo" AutomationProperties.AutomationId="VariantInfo"
                   Grid.Row="5" VerticalAlignment="Bottom" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</Window>
